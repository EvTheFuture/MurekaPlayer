#!/sbin/openrc-run
# Mureka Player listening together relay, for OpenRC (Alpine Linux)
#
# Set in /etc/conf.d/murekasync either the VPN interface and the port,
# MUREKASYNC_INTERFACE="wg0" and MUREKASYNC_PORT="8095", to listen on the
# interface's addresses, or one address, MUREKASYNC_LISTEN="10.0.0.1:8095"

name="murekasync"
description="Mureka Player listening together relay"

: ${MUREKASYNC_LISTEN:="127.0.0.1:8095"}
: ${MUREKASYNC_INTERFACE:=""}
: ${MUREKASYNC_PORT:="8095"}
: ${MUREKASYNC_USER:="nobody"}

command="/usr/local/bin/murekasync"

if [ -n "${MUREKASYNC_INTERFACE}" ]; then
    command_args="-interface ${MUREKASYNC_INTERFACE} -port ${MUREKASYNC_PORT}"
else
    command_args="-listen ${MUREKASYNC_LISTEN}"
fi

command_user="${MUREKASYNC_USER}"
command_background="yes"
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/${RC_SVCNAME}.log"
error_log="/var/log/${RC_SVCNAME}.log"

depend() {
    need net
    after firewall wireguard
}

start_pre() {
    checkpath --file --owner "${MUREKASYNC_USER}" --mode 0640 "${output_log}"
}
