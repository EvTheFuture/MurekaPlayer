#!/sbin/openrc-run
# Mureka Player listening together relay, for OpenRC (Alpine Linux)
#
# Installed as /etc/init.d/murekasync, set up in /etc/conf.d/murekasync
# (murekasync.confd): the VPN interface and port to listen on, or one
# address. Run under supervise-daemon, started again should it stop

name="murekasync"
description="Mureka Player listening together relay"

: ${MUREKASYNC_INTERFACE:=""}
: ${MUREKASYNC_PORT:="8095"}
: ${MUREKASYNC_LISTEN:="127.0.0.1:8095"}
: ${MUREKASYNC_WAIT:="2m"}
: ${MUREKASYNC_USER:="nobody"}
: ${MUREKASYNC_GROUP:="nobody"}
: ${MUREKASYNC_CHAT_KEEP:="24h"}
: ${MUREKASYNC_CHAT_MAX:="200"}

command="/usr/local/bin/murekasync"

if [ -n "${MUREKASYNC_INTERFACE}" ]; then
    command_args="-interface ${MUREKASYNC_INTERFACE} -port ${MUREKASYNC_PORT} -wait ${MUREKASYNC_WAIT}"
else
    command_args="-listen ${MUREKASYNC_LISTEN}"
fi

command_args="${command_args} -chat-keep ${MUREKASYNC_CHAT_KEEP} -chat-max ${MUREKASYNC_CHAT_MAX}"

command_user="${MUREKASYNC_USER}:${MUREKASYNC_GROUP}"
supervisor="supervise-daemon"
respawn_delay=5
respawn_max=0
output_log="/var/log/${RC_SVCNAME}.log"
error_log="/var/log/${RC_SVCNAME}.log"

depend() {
    need net
    after firewall wireguard
}

start_pre() {
    checkpath --file --owner "${MUREKASYNC_USER}:${MUREKASYNC_GROUP}" --mode 0640 "${output_log}"
}
